    <!--
      VersionOverridesV1_1 supersedes the V1_0 block above on hosts that
      support it (PowerPoint Microsoft 365 builds since 2018-2019). The
      V1_1 layer is what gives us shared runtime, which keeps a single
      JS context alive for the lifetime of the document — that lets us
      register a continuous selection-changed listener and keep
      Office.ribbon.requestUpdate in sync with the current selection
      regardless of whether the task pane is open. It also lets us spread
      the seven operations across three labelled groups so every command
      stays a one-click QAT-pinnable button.
    -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.1">
          <bt:Set Name="SharedRuntime" MinVersion="1.1" />
        </bt:Sets>
      </Requirements>
